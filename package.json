{
  "name": "revector-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.cjs",
    "dev": "npm run build && wrangler dev --ip 127.0.0.1 --port 8787",
    "test": "npm run build && node --test tests/*.test.js",
    "deploy": "npm run build && wrangler deploy",
    "check": "node scripts/check.cjs",
    "test:browser:account": "node scripts/browser-account.cjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "esbuild": "0.25.12",
    "playwright": "1.55.0",
    "prettier": "3.6.2",
    "wrangler": "4.40.2"
  }
}
