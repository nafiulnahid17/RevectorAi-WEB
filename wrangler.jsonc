{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "revector-web",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "ENGINE_ORIGIN": "https://YOUR-ENGINE-DOMAIN"
  },
  "observability": { "enabled": true }
}
